; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TinyTown"
config/description="A micro JRPG"
config/version="0.2.0"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
PlayerState="*res://scripts/player_state.gd"
Audio="*res://scripts/autoload/audio.gd"
SceneTransition="*res://scenes/scene_transition.tscn"
Dialogue="*res://scenes/ui/dialogue_box.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom="res://resources/theme.tres"

[editor]

movie_writer/movie_file="/home/deck/Videos/TinyTown.avi"

